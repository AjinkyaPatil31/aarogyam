generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres.ehfgftuntzfgublsdgqx:Aarogyam93132@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
}
    
model assessments {
  assessment_id    Int             @id @default(autoincrement())
  patient_id       Int?
  doctor_id        Int?
  visit_date       DateTime?       @default(now()) @db.Timestamp(6)
  bp_systolic      Int?
  bp_diastolic     Int?
  pulse            Int?
  spo2             Int?
  temperature      Decimal?        @db.Decimal(4, 1)
  respiratory_rate Int?
  has_dm           Boolean?        @default(false)
  has_htn          Boolean?        @default(false)
  has_asthma_copd  Boolean?        @default(false)
  has_hypothyroid  Boolean?        @default(false)
  cvs_exam         String?         @db.VarChar(255)
  cns_exam         String?         @db.VarChar(255)
  rs_exam          String?         @db.VarChar(255)
  diagnosis        String?         @db.VarChar(255)
  users            users?          @relation(fields: [doctor_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  patients         patients?       @relation(fields: [patient_id], references: [patient_id], onDelete: Cascade, onUpdate: NoAction)
  prescriptions    prescriptions[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model medicines {
  medicine_id         Int             @id @default(autoincrement())
  brand_name          String          @db.VarChar(150)
  generic_composition String?         @db.VarChar(255)
  category            String?         @db.VarChar(50)
  is_active           Boolean?        @default(true)
  prescriptions       prescriptions[]

  @@index([brand_name], map: "idx_medicine_name")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model patients {
  patient_id     Int           @id @default(autoincrement())
  full_name      String        @db.VarChar(150)
  age            Int
  sex            String?       @db.VarChar(10)
  weight         Decimal?      @db.Decimal(5, 2)
  blood_group    String?       @db.VarChar(5)
  contact_number String?       @db.VarChar(15)
  registered_by  Int?
  created_at     DateTime?     @default(now()) @db.Timestamp(6)
  assessments    assessments[]
  users          users?        @relation(fields: [registered_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([contact_number], map: "idx_patient_contact")
  @@index([full_name], map: "idx_patient_name")
}

model prescriptions {
  prescription_id      Int          @id @default(autoincrement())
  assessment_id        Int?
  medicine_id          Int?
  dosage               String?      @db.VarChar(50)
  frequency            String?      @db.VarChar(20)
  timing               String?      @db.VarChar(50)
  duration_days        Int?
  total_quantity       Int?
  special_instructions String?
  assessments          assessments? @relation(fields: [assessment_id], references: [assessment_id], onDelete: Cascade, onUpdate: NoAction)
  medicines            medicines?   @relation(fields: [medicine_id], references: [medicine_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  user_id       Int           @id @default(autoincrement())
  username      String        @unique @db.VarChar(50)
  password_hash String        @db.VarChar(255)
  role          String        @db.VarChar(20)
  display_name  String?       @db.VarChar(100)
  created_at    DateTime?     @default(now()) @db.Timestamp(6)
  assessments   assessments[]
  patients      patients[]
}
